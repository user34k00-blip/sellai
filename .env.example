# URL canonique : adapter en production (sans slash final).
APP_URL=http://localhost:3000
# Toutes les valeurs restent sur le serveur, aucun préfixe NEXT_PUBLIC.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
OPENAI_API_KEY=your-server-only-openai-key
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# Budgets anti-abus gratuits, indépendants des futurs crédits payants.
DAILY_LISTING_LIMIT=30
DAILY_IMAGE_LIMIT=5
